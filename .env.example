APP_NAME=TunerAI
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=change-me-long-random-secret
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/tunerai
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=tunerai
S3_REGION=us-east-1
S3_USE_SSL=true
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=.jsonl,.json
TUNERAI_DRY_RUN=true
TUNERAI_INLINE_TRAINING=true
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
ENABLE_REGISTRATION=true
ENABLE_GPU_TRAINING=false
